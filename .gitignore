node_modules/
.expo/
dist/
npm-debug.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
# expo router
expo-env.d.ts


# Anchored with a leading slash so these match ONLY the top-level CNG
# directories. Bare `ios` / `android` match at any depth, which silently
# excluded modules/nfc-native/{ios,android} — i.e. every line of hand-written
# Swift and Kotlin in Phase 4. Caught by expo-doctor, not by git.
/ios
/android

# macOS
.DS_Store

# Temporary files created by Metro to check the health of the file watcher
.metro-health-check*

# Build output inside local Expo modules. The anchored /android and /ios rules
# above deliberately do not reach here, so these need naming explicitly —
# otherwise a 247 MB APK tree lands in the repo.
modules/*/android/build/
modules/*/ios/build/

# The article draft and its screenshots stay local — never pushed to origin
drafts/
